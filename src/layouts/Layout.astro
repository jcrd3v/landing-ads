---
import "@fontsource/outfit";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Express Aires del Sur - Carritos importados"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/icono.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body
		class="font-['Outfit'] min-h-screen relative overflow-x-hidden bg-gradient-to-br from-sky-50 via-white to-blue-50"
	>
		<!-- Background Gradients -->
		<div class="fixed inset-0 -z-10">
			<div
				class="absolute inset-0 bg-gradient-to-br from-sky-50 via-white to-blue-50"
			>
			</div>
			<div
				class="absolute top-0 left-1/4 w-96 h-96 bg-[#187dd3]/20 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"
			>
			</div>
			<div
				class="absolute top-0 right-1/4 w-96 h-96 bg-blue-400/20 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"
			>
			</div>
			<div
				class="absolute -bottom-8 left-1/3 w-96 h-96 bg-cyan-300/20 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-4000"
			>
			</div>
		</div>

		<slot />
	</body>
</html>

<style is:global>
	@keyframes blob {
		0% {
			transform: translate(0px, 0px) scale(1);
		}
		33% {
			transform: translate(30px, -50px) scale(1.1);
		}
		66% {
			transform: translate(-20px, 20px) scale(0.9);
		}
		100% {
			transform: translate(0px, 0px) scale(1);
		}
	}
	.animate-blob {
		animation: blob 7s infinite;
	}
	.animation-delay-2000 {
		animation-delay: 2s;
	}
	.animation-delay-4000 {
		animation-delay: 4s;
	}
</style>
