---
import { X } from 'lucide-react';
import { products } from '../data/products';
---

<dialog id="product-modal" class="backdrop:bg-black/60 backdrop:backdrop-blur-sm bg-transparent p-0 w-full max-w-4xl rounded-2xl shadow-2xl m-auto open:animate-fade-in open:backdrop:animate-fade-in">
  <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row max-h-[90vh] md:max-h-[80vh]">
    
    <!-- Close Button -->
    <button id="close-modal" class="absolute top-4 right-4 z-50 bg-white/50 hover:bg-white/80 p-2 rounded-full transition-colors">
      <X size={24} />
    </button>

    <!-- Gallery Section -->
    <div class="w-full md:w-1/2 bg-gray-100/50 p-6 flex flex-col gap-4 overflow-y-auto">
      <div class="aspect-[4/3] rounded-xl overflow-hidden bg-white shadow-inner">
        <img id="modal-main-image" src="" alt="Producto" class="w-full h-full object-cover" />
      </div>
      <div class="grid grid-cols-3 gap-2" id="modal-gallery-grid">
        <!-- Thumbnails injected via JS -->
      </div>
    </div>

    <!-- Details Section -->
    <div class="w-full md:w-1/2 p-8 flex flex-col overflow-y-auto">
      <h2 id="modal-title" class="text-3xl font-extrabold text-gray-900 mb-2">Nombre Modelo</h2>
      
      <div class="flex items-baseline gap-3 mb-6">
        <span id="modal-price" class="text-3xl font-bold text-indigo-600">S/ 000</span>
        <span id="modal-old-price" class="text-lg text-gray-500 line-through hidden">S/ 000</span>
      </div>

      <p id="modal-description" class="text-gray-700 mb-6 leading-relaxed">
        Descripción del producto...
      </p>

      <div class="mb-8">
        <h3 class="font-bold text-gray-900 mb-3">Características Destacadas:</h3>
        <ul id="modal-features" class="space-y-2">
          <!-- Features injected via JS -->
        </ul>
      </div>

      <!-- Color Selection for WhatsApp -->
      <div class="mb-6">
        <h3 class="font-bold text-gray-900 mb-2">Color Seleccionado: <span id="modal-selected-color-name" class="font-normal text-gray-600"></span></h3>
        <div class="flex gap-3" id="modal-color-selector">
          <!-- Colors injected via JS -->
        </div>
      </div>

      <div class="mt-auto pt-4 border-t border-gray-200">
        <a 
          id="modal-whatsapp-btn"
          href="#"
          target="_blank"
          class="w-full bg-[#25D366] hover:bg-[#20BA5A] text-white py-4 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-3"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Pedir por WhatsApp
        </a>
        <p class="text-center text-xs text-gray-500 mt-2">Consultar stock y envíos</p>
      </div>
    </div>
  </div>
</dialog>

<script define:vars={{ products }}>
  // Make products available globally or just use them in the closure
  // define:vars passes 'products' as a JSON object to the script
  
  const modal = document.getElementById('product-modal');
  const closeBtn = document.getElementById('close-modal');
  const mainImage = document.getElementById('modal-main-image');
  const galleryGrid = document.getElementById('modal-gallery-grid');
  const title = document.getElementById('modal-title');
  const price = document.getElementById('modal-price');
  const oldPrice = document.getElementById('modal-old-price');
  const description = document.getElementById('modal-description');
  const featuresList = document.getElementById('modal-features');
  const colorSelector = document.getElementById('modal-color-selector');
  const selectedColorName = document.getElementById('modal-selected-color-name');
  const whatsappBtn = document.getElementById('modal-whatsapp-btn');

  let currentProduct = null;
  let selectedColor = null;

  // Open Modal Logic
  document.addEventListener('click', (e) => {
    const target = e.target.closest('.view-details-btn');
    if (target) {
      const productId = target.dataset.productId;
      const product = products.find(p => p.id === productId);
      if (product) {
        openModal(product);
      }
    }
  });

  closeBtn.addEventListener('click', () => {
    modal.close();
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  function openModal(product) {
    currentProduct = product;
    selectedColor = product.colors[0]; // Default to first color

    // Update Content
    title.textContent = product.modelName;
    price.textContent = `S/ ${product.price}`;
    
    if (product.oldPrice > product.price) {
      oldPrice.textContent = `S/ ${product.oldPrice}`;
      oldPrice.classList.remove('hidden');
    } else {
      oldPrice.classList.add('hidden');
    }

    description.textContent = product.description;

    // Features
    featuresList.innerHTML = product.features.map(feature => `
      <li class="flex items-center gap-2 text-gray-600">
        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        ${feature}
      </li>
    `).join('');

    // Colors
    updateColorSelection();

    // Gallery (Initialize with first color image + gallery)
    updateGallery();

    modal.showModal();
    updateWhatsAppLink();
  }

  function updateColorSelection() {
    selectedColorName.textContent = selectedColor.name;
    colorSelector.innerHTML = currentProduct.colors.map(color => `
      <button 
        class="w-8 h-8 rounded-full border-2 ${selectedColor.name === color.name ? 'border-indigo-600 ring-2 ring-indigo-200' : 'border-gray-200'} shadow-sm transition-transform hover:scale-110"
        style="background-color: ${color.hex}"
        onclick="selectColor('${color.name}')"
      ></button>
    `).join('');
  }

  // Expose selectColor to global scope for onclick attribute
  window.selectColor = (colorName) => {
    const color = currentProduct.colors.find(c => c.name === colorName);
    if (color) {
      selectedColor = color;
      updateColorSelection();
      updateGallery(); // Update main image to match color
      updateWhatsAppLink();
    }
  };

  function updateGallery() {
    // Main image is the selected color image
    mainImage.src = selectedColor.imageUrl;

    // Thumbnails: Color images + Gallery images
    // We'll show the current color image first, then gallery
    const images = [selectedColor.imageUrl, ...currentProduct.gallery];
    
    galleryGrid.innerHTML = images.map((img, index) => `
      <button 
        class="aspect-square rounded-lg overflow-hidden border-2 ${img === mainImage.src ? 'border-indigo-600' : 'border-transparent'} hover:border-indigo-400 transition-all"
        onclick="document.getElementById('modal-main-image').src = '${img}'"
      >
        <img src="${img}" class="w-full h-full object-cover" />
      </button>
    `).join('');
  }

  function updateWhatsAppLink() {
    const phone = "51999999999";
    const message = `Hola ADS, me interesa el modelo ${currentProduct.modelName} en color ${selectedColor.name}. ¿Tienen stock?`;
    const encodedMessage = encodeURIComponent(message);
    whatsappBtn.href = `https://wa.me/${phone}?text=${encodedMessage}`;
  }
</script>

<style>
  dialog::backdrop {
    animation: fade-in 0.3s ease-out;
  }
  dialog[open] {
    animation: slide-up 0.3s ease-out;
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slide-up {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>
